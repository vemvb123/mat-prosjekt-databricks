# Databricks user email. Used to build the workspace path to this repo.
USER_EMAIL=your.email@example.com

# Databricks SQL warehouse ID used by the SQL tasks in weekly_scrape_job.py.
WAREHOUSE_ID=your_warehouse_id

# Azure Blob Storage account URL where raw JSON files are stored.
AZURE_STORAGE_ACCOUNT_URL=https://your_storage_account.blob.core.windows.net

# Databricks Service Credential name with access to the blob storage account.
AZURE_STORAGE_CREDENTIAL_NAME=your_service_credential_name

# Exact JSON blob that products.py should read into the products table.
PRODUCTS_BLOB_NAME=customer_support/weekly_data_YYYYMMDDTHHMMSSZ.json
